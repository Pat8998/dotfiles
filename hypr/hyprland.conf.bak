# #######################################################################################
# AUTOGENERATED HYPRLAND CONFIG.
# EDIT THIS CONFIG ACCORDING TO THE WIKI INSTRUCTIONS.
# #######################################################################################

#autogenerated = 1 # remove this line to remove the warning

# This is an example Hyprland config file.
# Refer to the wiki for more information.
# https://wiki.hypr.land/Configuring/

# Please note not all available settings / options are set here.
# For a full list, see the wiki

# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
#source = ~/.config/hypr/send.conf


################
### MONITORS ###
################

# See https://wiki.hypr.land/Configuring/Monitors/
monitor=,preferred,auto,auto
#monitor=,1280x720,auto,auto
#monitor=,1920x1080,auto,auto, transform, 3
#monitor=, 2560x1440 ,auto,auto
#monitor = HDMI-A-1, 1920x1080, 1920x0, 1
#monitor = HDMI-A-1, 1280x720, 0x0, 1

###################
### MY PROGRAMS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/



# Set programs that you use
$terminal = kitty
$fileManager = dolphin
$menu = wofi -I -p " $(date +%H:%M) <3" --show
$toolbox = printf "\npingd\nsystemctl suspend\nnmtui\nimpala\nbtop\nbluetui\nlove antiburn\npoweroff\nwiremix\nnano .config/hypr/hyprland.conf\nfirefox --new-window Desktop/numworks.html --kiosk \nstart-hyprland\n" | wofi --dmenu --prompt "System" | xargs -r kitty -e -c exec 
#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = rm -r /home/emma/.copilot/
exec-once = sudo cp /home/emma/Pictures/Wallpapers/wall* /usr/share/hypr/

#exec-once = $terminal
exec-once = cp .cache/wofi-drun.bak .cache/wofi-drun
# exec-once = nm-applet &
# exec-once = waybar & hyprpaper & firefox


#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hypr.land/Configuring/Environment-variables/

env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24


###################
### PERMISSIONS ###
###################

# See https://wiki.hypr.land/Configuring/Permissions/
# Please note permission changes here require a Hyprland restart and are not applied on-the-fly
# for security reasons

# ecosystem {
#   enforce_permissions = 1
# }

# permission = /usr/(bin|local/bin)/grim, screencopy, allow
# permission = /usr/(lib|libexec|lib64)/xdg-desktop-portal-hyprland, screencopy, allow
# permission = /usr/(bin|local/bin)/hyprpm, plugin, allow


#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hypr.land/Configuring/Variables/

# https://wiki.hypr.land/Configuring/Variables/#general
general {
    gaps_in = 1
    gaps_out = 5

    border_size = 2

    # https://wiki.hypr.land/Configuring/Variables/#variable-types for info about colors
    col.active_border = rgba(ff00ffee) rgba(800080ee) 45deg
    col.inactive_border = rgba(595959aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = false

    # Please see https://wiki.hypr.land/Configuring/Tearing/ before you turn this on
    allow_tearing = false

    layout = dwindle
}

# https://wiki.hypr.land/Configuring/Variables/#decoration
decoration {
    rounding = 10
    rounding_power = 2

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 0.9

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }

    # https://wiki.hypr.land/Configuring/Variables/#blur
    blur {
        enabled = true
        size = 3
        passes = 1

        vibrancy = 0.1696
    }
}





# https://wiki.hypr.land/Configuring/Variables/#animations
animations {
    enabled = yes, please :)

    # Default curves, see https://wiki.hypr.land/Configuring/Animations/#curves
    #        NAME,           X0,   Y0,   X1,   Y1
    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1

    # Default animations, see https://wiki.hypr.land/Configuring/Animations/
    #           NAME,          ONOFF, SPEED, CURVE,        [STYLE]
    animation = global,        1,     10,    default
    animation = border,        1,     5.39,  easeOutQuint
    animation = windows,       1,     4.79,  easeOutQuint
    animation = windowsIn,     1,     4.1,   easeOutQuint, popin 87%
    animation = windowsOut,    1,     1.49,  linear,       popin 87%
    animation = fadeIn,        1,     1.73,  almostLinear
    animation = fadeOut,       1,     1.46,  almostLinear
    animation = fade,          1,     3.03,  quick
    animation = layers,        1,     3.81,  easeOutQuint
    animation = layersIn,      1,     4,     easeOutQuint, fade
    animation = layersOut,     1,     1.5,   linear,       fade
    animation = fadeLayersIn,  1,     1.79,  almostLinear
    animation = fadeLayersOut, 1,     1.39,  almostLinear
    animation = workspaces,    1,     1.94,  almostLinear, fade
    animation = workspacesIn,  1,     1.21,  almostLinear, fade
    animation = workspacesOut, 1,     1.94,  almostLinear, fade
    animation = zoomFactor,    1,     7,     quick
}
# Ref https://wiki.hypr.land/Configuring/Workspace-Rules/
# "Smart gaps" / "No gaps when only"
# uncomment all if you wish to use that.
# workspace = w[tv1], gapsout:0, gapsin:0
# workspace = f[1], gapsout:0, gapsin:0
# windowrule = bordersize 0, floating:0, onworkspace:w[tv1]
# windowrule = rounding 0, floating:0, onworkspace:w[tv1]
# windowrule = bordersize 0, floating:0, onworkspace:f[1]
# windowrule = rounding 0, floating:0, onworkspace:f[1]

# See https://wiki.hypr.land/Configuring/Dwindle-Layout/ for more
dwindle {
    preserve_split = true # You probably want this
}

# See https://wiki.hypr.land/Configuring/Master-Layout/ for more
master {
    new_status = master
}

# https://wiki.hypr.land/Configuring/Variables/#misc
misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
}


#############
### INPUT ###
#############

# https://wiki.hypr.land/Configuring/Variables/#input
input {
    kb_layout = fr, us
    kb_variant = azerty,
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    numlock_by_default = true
    touchpad {
        natural_scroll = false
        disable_while_typing = false
	}
}

env = HYPRCURSOR_THEME, caca
env = HYPRCURSOR_SIZE, 50

$bright_panel = out=$( brightnessctl -m | grep -o -P "..%," | grep -P "\d+" -o); echo "$out" ; vol=$( brightnessctl -m | grep -o -P "..%," | grep -P "\d+" -o); filled=$((vol * 20 / 100)); empty=$((20 - filled)); bar=$((( filled == 0 )) && printf '\uEE00' || printf '\uEE03')$(for ((i=((filled==20));i<$(($filled-1));i++)); do printf '\uEE04'; done)$(for ((i=((filled==0));i<$(($empty-1));i++)); do printf '\uEE01'; done)$((( filled == 20 )) && printf '\uEE05' || printf '\uEE02'); notify-send -r 997 -i "/usr/share/icons/Adwaita/symbolic/status/display-brightness-symbolic.svg" "$bar $out%" -t 700
# See https://wiki.hypr.land/Configuring/Gestures
gestures {
gesture = 3, horizontal, workspace

gesture = 4, up, scale: 1.5, fullscreen
gesture = 3, vertical, special, magic
gesture = 4, pinch, dispatcher, exec, $toolbox
gesture = 4, left, dispatcher, exec, brightnessctl set 10%- && $bright_panel
gesture = 4, right, dispatcher, exec, brightnessctl set 10%+ && $bright_panel
#gesture = 4, pinch, dispatcher, exec, kitty
}




# Example per-device config
# See https://wiki.hypr.land/Configuring/Keywords/#per-device-input-configs for more
device {
    name = epic-mouse-v1
    sensitivity = -0.5
}



###################
### KEYBINDINGS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier


# Example binds, see https://wiki.hypr.land/Configuring/Binds/ for more
bind = $mainMod, Q, exec, $terminal
bind = $mainMod, T, exec, adb connect 192.168.1.69:31415 && ARGS="--no-audio --new-display=1920x1080 --shortcut-mod=lctrl"; scrcpy $ARGS || scrcpy $ARGS -s "$(adb devices | awk "NR>1 && \$2==\"device\"{print \$1; exit}")" && notify-send exit
bind = $mainMod, C, killactive,
bind = $mainMod, M, exit,
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
#bind = $mainMod, Super_L, exec, pgrep -x wofi && pkill wofi ||  $menu drun
bind = $mainMod, Super_L, exec, active=$(hyprctl activewindow -j | jq -r ".class"); if [[ "$active" != "scrcpy" ]]; then pgrep -x wofi && pkill wofi ||  $menu drun; fi 
bind = $mainMod, B, exec, $terminal --start-as=fullscreen btop 
bind = $mainMod, R, exec, $menu run 
#bind = , twosuperior, exec, printf "nmtui\nbtop\nbluetui\nlove antiburn\npoweroff\nwiremix\nnano .config/hypr/hyprland.conf\nfirefox --new-window Desktop/numworks.html --kiosk \n\n" | wofi --dmenu --prompt "System" | xargs -r kitty -e
bind = , twosuperior, exec, $toolbox
bind = $mainMod, O, pseudo, # dwindle
bindd = $mainMod, J, $d toggle split, layoutmsg, togglesplit
bind = $mainMod, K, exec, notify-send "$(nm-online -t 1)"



#bind = 	 $mainMod, A, exec, echo toolbox.json > ~/.config/crcl-select/json_name; ~/.config/crcl-select/angle 0 & eww open Circle -c ~/.config/crcl-select/ 
#bindr =       	 $mainMod, A, exec, ~/.config/crcl-select/exe toolbox.json $(~/.config/crcl-select/angle)   & eww close-all -c ~/.config/crcl-select/
bind =		$mainMod, A, exec, crcl-select open toolbox.json  
bindr =		$mainMod, A, exec, crcl-select close toolbox.json



#bindel = $mainMod, f1, exec, notify-send "$(cat /sys/class/power_supply/BAT1/capacity) %" -i "$([[ "$(cat /sys/class/power_supply/BAT1/status)" = Charging ]] && echo /usr/share/icons/Adwaita/symbolic/legacy/battery-good-charging-symbolic.svg || echo /usr/share/icons/Adwaita/symbolic/legacy/battery-good-symbolic.svg)" -t 700
#bindel = $mainMod, F1, exec, sh -c 'cap=$(cat /sys/class/power_supply/BAT1/capacity); stat=$(cat /sys/class/power_supply/BAT1/status); if [ "$stat" = Charging ]; then icon=$([ $cap -le 10 ] && echo battery-empty-charging-symbolic.svg || [ $cap -le 25 ] && echo battery-low-charging-symbolic.svg || [ $cap -le 90 ] && echo battery-full-charging-symbolic.svg  || [ $cap -le 95 ] && echo battery-full-charging-symbolic.svg || echo battery-full-charged-symbolic.svg); else icon=$([ $cap -le 10 ] && echo battery-empty-symbolic.svg || [ $cap -le 25 ] && echo battery-caution-symbolic.svg || [ $cap -le 70 ] && echo battery-good-symbolic.svg || echo battery-full-symbolic.svg); fi; notify-send -r 998 -i "/usr/share/icons/Adwaita/symbolic/legacy/$icon" "$cap%" -t 700'
#bindel = $mainMod, F1, exec, sh -c 'cap=$(cat /sys/class/power_supply/BAT1/capacity); stat=$(cat /sys/class/power_supply/BAT1/status); if [ "$stat" = Charging ]; then if [ "$cap" -le 10 ]; then icon=battery-empty-charging-symbolic.svg ; elif [ "$cap" -le 25 ]; then icon=battery-low-charging-symbolic.svg;elif [ "$cap" -le 70 ]; then  icon=battery-good-charging-symbolic.svg;elif [ "$cap" -le 90 ]; then  icon=battery-full-charging-symbolic.svg;else  icon=battery-full-charged-symbolic.svg;fi; else icon=$([ $cap -le 10 ] && echo battery-empty-symbolic.svg || [ $cap -le 25 ] && echo battery-good-symbolic.svg || [ $cap -le 70 ] && echo battery-good-symbolic.svg || echo battery-full-symbolic.svg); fi; notify-send -r 998 -i "/usr/share/icons/Adwaita/symbolic/legacy/$icon" "$cap%" -t 700'
bindel = $mainMod, F1, exec, sh -c 'cap=$(cat /sys/class/power_supply/BAT1/capacity); stat=$(cat /sys/class/power_supply/BAT1/status); level=$(((cap+3) / 10 * 10)); if [ "$stat" = "Charging" ]; then icon="battery-level-${level}-charging-symbolic.svg"; else icon="battery-level-${level}-symbolic.svg"; fi; notify-send -r 998 -i "/usr/share/icons/Adwaita/symbolic/status/$icon" "$cap%" -t 700 '


bind = ALTMOD, Shift_L, exec, hyprctl switchxkblayout all next && notify-send "$(hyprctl devices | grep keymap | head -1)"  -i /usr/share/icons/Pop/scalable/apps/accessories-character-map-symbolic.svg -r 998

bind = $mainMod, P, fullscreen, immediate
bind = SHIFT ,f1,exec, systemctl suspend
#bind = ,XF86WakeUp,exec, timedatectl >> ~/caca


# Mute and lock the system
bind = $mainMod, L, exec, hyprlock




# Move focus with mainMod + arrow keys
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, ampersand, workspace, 1
bind = $mainMod, eacute, workspace, 2
bind = $mainMod, quotedbl, workspace, 3
bind = $mainMod, apostrophe, workspace, 4
bind = $mainMod, parenleft, workspace, 5
bind = $mainMod, minus, workspace, 6
bind = $mainMod, egrave, workspace, 7
bind = $mainMod, underscore, workspace, 8
bind = $mainMod, ccedilla, workspace, 9
bind = $mainMod, agrave, workspace, 10


# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, ampersand, movetoworkspace, 1
bind = $mainMod SHIFT, eacute, movetoworkspace, 2
bind = $mainMod SHIFT, quotedbl, movetoworkspace, 3
bind = $mainMod SHIFT, apostrophe, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

bind = $mainMod, x, workspace, +1
bind = SUPER, w, workspace, -1
bind = SUPER SHIFT, TAB, exec, sh -c 'hyprctl clients -j | jq -r ".[] | \"WS \\(.workspace.id)::\\(.title)\"" | wofi --dmenu -p Workspaces | sed "s/::.*//; s/WS //" | xargs -r hyprctl dispatch workspace'


# Example special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = ALTMOD, tab, workspace, e+1
bind = ALTMOD SHIFT, tab, workspace, e-1
bind = $mainMod, mouse_up, workspace, e-1

bind = SUPER, TAB, cyclenext
bind = SUPER SHIFT, TAB, cyclenext, prev


# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow


$sound_panel = out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@); echo "$out" | grep -q MUTED && muted=1 || muted=0; vol=$(echo "$out" | awk "{print int(\$2 * 100)}"); filled=$(((vol * 20 / 100))); empty=$((20 - filled));bar=$((( filled == 0 )) && printf '\uEE00' || printf '\uEE03')$(for ((i=((filled==20));i<$(($filled-1));i++)); do printf '\uEE04'; done)$(for ((i=((filled==0));i<$(($empty-1));i++)); do printf '\uEE01'; done)$((( filled == 20 )) && printf '\uEE05' || printf '\uEE02'); if [ "$muted" -eq 1 ]; then icon=audio-volume-muted-symbolic.svg; elif [ "$vol" -gt 100 ]; then icon=audio-volume-overamplified-symbolic.svg; elif [ "$vol" -le 30 ]; then icon=audio-volume-low-symbolic.svg; elif [ "$vol" -le 70 ]; then icon=audio-volume-medium-symbolic.svg; else icon=audio-volume-high-symbolic.svg; fi; notify-send -r 997 -i "/usr/share/icons/Adwaita/symbolic/status/$icon" "$bar $vol%" -t 700
# Laptop multimedia keys for volume and LCD brightness
#bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && $sound_panel
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $sound_panel
#bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep MUTED && notify-send " " -i /usr/share/icons/Adwaita/symbolic/status/audio-volume-muted-symbolic.svg  -r 998|| notify-send -r 998 $(wpctl get-volume @DEFAULT_AUDIO_SINK@)
#bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle &&  $sound_panel
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = $mainMod ,f3, exec, brightnessctl -e4 -n2 set 5%+ && $bright_panel
bindel = $mainMod,f10, exec, brightnessctl -e4 -n2 set 15%+
bindel = $mainMod,f9, exec, brightnessctl -e4 -n2 set 15%-
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-
bindel = $mainMod,f2, exec, brightnessctl -e4 -n2 set 5%- && $bright_panel
bindel =  SHIFT,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 0
bindel =  SHIFT,XF86MonBrightnessUP, exec, brightnessctl -e4 -n2 set 100




# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = $mainMod, XF86AudioRaiseVolume, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = $mainMod, f8, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous



# Screenshot a window
bind = $mainMod, PRINT, exec, hyprshot -m window --clipboard-only
# Screenshot a monitor
bind = , PRINT, exec, hyprshot -m output --clipboard-only
bind = $controlMod, PRINT, exec, hyprshot -m output
# Screenshot a region
bind = $shiftMod, PRINT, exec, hyprshot -m region --clipboard-only

#stupid Binds bc my keyboard sucks
bind = SUPER, F12, exec, sh -c 'rfkill toggle wifi; rfkill list wifi | grep -q "Soft blocked: yes" && notify-send -r 999 -i /usr/share/icons/Cosmic/scalable/status/network-wireless-disconnected-symbolic.svg "Wi-Fi" "Disabled" || notify-send -r 999 -i /usr/share/icons/Cosmic/scalable/status/network-wireless-signal-excellent-symbolic.svg "Wi-Fi" "Enabled"'
bind = SHIFT, F12, exec, sh -c 'rfkill toggle bluetooth; rfkill list bluetooth | grep "Soft blocked: yes" && notify-send "Disabled" -r 998 -i /usr/share/icons/Cosmic/scalable/status/bluetooth-disabled-symbolic.svg || notify-send -r 998 -i /usr/share/icons/Cosmic/scalable/status/bluetooth-active-symbolic.svg  "Enabled"'


##############################
bindl = , XF86AudioPrev, exec, playerctl previous

##############################
bindl = , XF86AudioPrev, exec, playerctl previous

##############################
bindl = , XF86AudioPrev, exec, playerctl previous


#############################
submap = scrcpy

unbind = SUPER
bind = SUPER, escape, submap, reset

submap = reset



source = ~/.config/hypr/sm-send-hypr.conf



